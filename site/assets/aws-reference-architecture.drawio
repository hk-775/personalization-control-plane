        <mxCell id="ops_note" value="Privacy-redacted telemetry · authorization denials · allocation drift · guardrail latency · audit verification · backup restore · independent kill-switch drills" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;fontColor=#545B64;fontSize=10;" vertex="1" parent="ops"><mxGeometry x="455" y="37" width="245" height="50" as="geometry"/></mxCell>
        <mxCell id="external" value="Governed external interfaces" style="swimlane;startSize=48;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;fillColor=#FFFFFF;strokeColor=#4F627D;strokeWidth=2;dashed=1;fontColor=#10203D;fontStyle=1;fontSize=13;html=1;" vertex="1" parent="1"><mxGeometry x="1700" y="255" width="180" height="430" as="geometry"/></mxCell>
        <mxCell id="consent" value="Authoritative consent + withdrawal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontColor=#334E68;fontSize=10;" vertex="1" parent="external"><mxGeometry x="18" y="75" width="145" height="60" as="geometry"/></mxCell>
        <mxCell id="features" value="Reviewed feature + candidate systems" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontColor=#334E68;fontSize=10;" vertex="1" parent="external"><mxGeometry x="18" y="165" width="145" height="60" as="geometry"/></mxCell>
        <mxCell id="analytics" value="Offline statistics + impact review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA6B2;fontColor=#334E68;fontSize=10;" vertex="1" parent="external"><mxGeometry x="18" y="255" width="145" height="60" as="geometry"/></mxCell>
        <mxCell id="external_note" value="No raw identity or unreviewed feature access. High-impact decisions remain out of scope." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#B42318;fontColor=#B42318;fontSize=9;" vertex="1" parent="external"><mxGeometry x="18" y="345" width="145" height="65" as="geometry"/></mxCell>
        <mxCell id="reference_note" value="REFERENCE ARCHITECTURE — the current v0.1 demo provisions none of these AWS resources. Production adaptation requires reviewed IaC, tenant isolation, authoritative consent, domain impact assessment, migration and restore tooling, statistical validation, and independent security and privacy review." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontColor=#7A5C00;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="985" width="1300" height="68" as="geometry"/></mxCell>
