        <mxCell id="worker" value="AWS Lambda&lt;br&gt;metrics + guardrail worker" style="outlineConnect=0;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;shape=mxgraph.aws3.lambda_function;fillColor=#F58534;gradientColor=none;fontColor=#232F3E;fontSize=10;" vertex="1" parent="service_plane"><mxGeometry x="685" y="52" width="64" height="67" as="geometry"/></mxCell>
        <mxCell id="core" value="&lt;b&gt;Governed decision path&lt;/b&gt;&lt;br&gt;consent + purpose · sensitive-input rejection · deterministic allocation · safety floor · multi-objective ranking · human approval · kill switch · automatic rollback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#147EBA;strokeWidth=2;fontColor=#232F3E;fontSize=12;" vertex="1" parent="service_plane"><mxGeometry x="70" y="205" width="680" height="95" as="geometry"/></mxCell>
        <mxCell id="service_note" value="Private subnets · no public task IPs · VPC endpoints for AWS services · tenant and purpose partitioning · bounded payloads and timeouts · independently operable kill path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F8FC;strokeColor=#6C8EBF;fontColor=#545B64;fontSize=10;" vertex="1" parent="service_plane"><mxGeometry x="70" y="330" width="680" height="45" as="geometry"/></mxCell>
