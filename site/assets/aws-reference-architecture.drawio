        <mxCell id="identity_note" value="&lt;b&gt;Identity and privacy boundary&lt;/b&gt;&lt;br&gt;Server-derived actors and scoped workload roles. Raw subject identifiers remain outside the control plane. Purpose, consent state, tenant, request id, and policy version are bound to accepted requests." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#545B64;fontSize=11;" vertex="1" parent="edge"><mxGeometry x="865" y="45" width="500" height="115" as="geometry"/></mxCell>
